#!/usr/bin/env python3
"""Remove host integration only; retain checkout and device backups."""
from pathlib import Path
import subprocess
import sys
root=Path(__file__).resolve().parents[1]
link=Path.home()/'.config/omarchy/plugins/fraction12.codex-micro'
if link.exists() and (not link.is_symlink() or link.resolve()!=root):
    raise SystemExit('Installed plugin path does not belong to this checkout')
subprocess.run(['omarchy','plugin','disable','fraction12.codex-micro'],check=True)
base=Path.home()/'.config/hypr'
config=base/'bindings.lua'
marker='-- Omarchy Codex Micro: versioned mappings in the plugin checkout.'
line='dofile(os.getenv("HOME") .. "/.config/hypr/codex-micro.lua")'
config.write_text('\n'.join(x for x in config.read_text().splitlines() if x not in (marker,line))+'\n')
generated=base/'codex-micro.lua'
if generated.exists():
    if not generated.read_text().startswith('-- Generated by Omarchy Codex Micro;'):
        raise SystemExit('Generated file was replaced; leaving it in place')
    generated.unlink()
if link.is_symlink():link.unlink()
subprocess.run(['hyprctl','reload'],check=True)
subprocess.run(['hyprctl','configerrors'],check=True)
subprocess.run(['omarchy-shell','shell','rescanPlugins'],check=True)
print('Host integration removed. Source, backups, device mappings, and udev access are retained; see README for restoring/removing those.')
